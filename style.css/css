:root {
    --bg: #f6f2ed;
    --paper: #fffdf9;
    --ink: #241f1b;
    --muted: #766d66;
    --line: #e5dbd1;
    --rose: #9c6e61;
    --rose2: #ead4ca;
    --gold: #ae8b5b;
    --dark: #29231f;
    --shadow: 0 20px 55px #39291b16;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; background: var(--bg); color: var(--ink); font-family: 'DM Sans', sans-serif; font-size: 15px; line-height: 1.5; }
main { display: block; }
section[id] { scroll-margin-top: 100px; }
.wrap { max-width: 1240px; width: min(100%, 1240px); margin: auto; padding: 0 24px; }

/* Top e Header */
.top { background: var(--dark); color: #fff; padding: 10px 20px; text-align: center; font-size: 11px; letter-spacing: .8px; text-transform: uppercase; }
.header { background: #fffdf9eF; backdrop-filter: blur(14px); box-shadow: 0 1px 0 #39291b0a; border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 20; }
.head { height: 82px; display: flex; align-items: center; gap: 34px; }
.brand { font-family: 'Playfair Display', serif; font-size: 29px; letter-spacing: -.3px; white-space: nowrap; }
.brand small { display: block; font: 9px 'DM Sans'; letter-spacing: 2.4px; text-transform: uppercase; color: var(--muted); margin-top: -2px; }

/* Navegação */
.nav { display: flex; gap: 28px; align-items: center; flex: 1; justify-content: center; }
.nav a { color: var(--ink); text-decoration: none; font-size: 12px; font-weight: 600; letter-spacing: .2px; position: relative; }
.nav a:after { content: ""; position: absolute; left: 0; right: 100%; bottom: -7px; height: 1px; background: var(--rose); transition: .25s; }
.nav a:hover { color: var(--rose); }
.nav a:hover:after { right: 0; }
.actions { display: flex; gap: 10px; }
.icon { border: 1px solid var(--line); background: white; border-radius: 50%; width: 42px; height: 42px; cursor: pointer; font-size: 17px; transition: .2s; }
.icon:hover { background: var(--rose2); border-color: var(--rose); transform: translateY(-2px); }

/* Hero Section */
.hero { padding: 42px 0 28px; }
.heroGrid { display: grid; grid-template-columns: 1.05fr .95fr; min-height: 535px; border-radius: 5px; overflow: hidden; background: linear-gradient(116deg, #eee2d9, #fbf8f4 57%, #e4cfc4); box-shadow: var(--shadow); }
.heroCopy { padding: 72px 76px; display: flex; flex-direction: column; justify-content: center; }
.eyebrow { font-size: 11px; text-transform: uppercase; letter-spacing: 2.4px; color: var(--rose); font-weight: 700; }
.hero h1 { font: 600 clamp(44px, 5vw, 72px) / 1.02 'Playfair Display', serif; letter-spacing: -1px; max-width: 620px; margin: 20px 0 15px; }
.hero p { font-size: 16px; line-height: 1.8; color: var(--muted); max-width: 500px; }

/* Botões */
.buttons { display: flex; gap: 12px; margin-top: 28px; }
.btn { padding: 15px 23px; border-radius: 3px; text-decoration: none; border: 1px solid var(--dark); font-weight: 700; font-size: 13px; letter-spacing: .2px; cursor: pointer; transition: .2s; }
.btn:hover { transform: translateY(-2px); box-shadow: 0 10px 20px #39291b18; }
.primary { background: var(--dark); color: white; }
.secondary { color: var(--dark); background: #fff8; }

/* Hero Arte */
.heroArt { position: relative; min-height: 535px; background: radial-gradient(circle at 50% 42%, #fff 0 12%, transparent 12.5%), linear-gradient(145deg, #d1ada0, #f3e6de 58%, #dbc0b3); }
.heroArt:after { content: "CAROL\A PRESENTES"; white-space: pre; text-align: center; position: absolute; right: 12%; top: 15%; font: 600 10px/1.7 'DM Sans'; letter-spacing: 3px; color: #fff9; transform: rotate(90deg); }
.bottle { position: absolute; width: 165px; height: 285px; background: linear-gradient(90deg, #9d776b, #e8c9bd 48%, #8c675e); border-radius: 34px 34px 22px 22px; left: 47%; top: 27%; transform: translateX(-50%) rotate(-6deg); box-shadow: 35px 30px 55px #50372b30; }
.bottle:before { content: ''; position: absolute; width: 62px; height: 45px; background: #b79570; left: 44px; top: -39px; border-radius: 8px 8px 4px 4px; }
.bottle:after { content: 'CAROL\A PRESENTES'; white-space: pre; position: absolute; inset: 90px 17px auto; text-align: center; font: 600 13px/1.5 'Playfair Display'; color: #fff; }
.flower { position: absolute; font-size: 70px; filter: grayscale(.2); opacity: .5; }
.f1 { left: 12%; top: 18%; }
.f2 { right: 13%; bottom: 16%; font-size: 55px; }

/* Benefícios */
.benefits { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border-radius: 3px; overflow: hidden; margin: 0 0 78px; box-shadow: 0 8px 25px #39291b08; }
.benefit { background: #fffdfa; padding: 25px 20px; text-align: center; }
.benefit b { display: block; font-size: 13px; margin-bottom: 6px; }
.benefit span { font-size: 12px; color: var(--muted); }

/* Seções Padrão */
section { padding: 20px 0 65px; }
section:not(.catalog) { padding-top: 8px; }
.sectionHead { display: flex; justify-content: space-between; align-items: end; margin-bottom: 28px; }
.sectionHead h2 { font: 600 32px 'Playfair Display'; letter-spacing: -.4px; margin: 0 0 5px; }
.sectionHead p { margin-top: 0; color: var(--muted); font-size: 14px; }

/* Coleções */
.collections { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
.collection { height: 205px; border-radius: 4px; padding: 22px; display: flex; flex-direction: column; justify-content: end; text-decoration: none; color: var(--ink); background: linear-gradient(145deg, #e5d0c5, #f9f1eb); position: relative; overflow: hidden; transition: .25s; }
.collection:nth-child(2n) { background: linear-gradient(145deg, #ded9d0, #f7f3ed); }
.collection:hover { transform: translateY(-5px); box-shadow: 0 14px 25px #39291b18; }
.collection:before { content: '✦'; position: absolute; right: 18px; top: 12px; font-size: 60px; opacity: .15; }
.collection strong { font: 600 22px 'Playfair Display'; }
.collection span { font-size: 12px; color: var(--muted); margin-top: 4px; }

/* Catálogo & Ferramentas */
.catalog { background: #fffdf9; margin-top: 78px; padding: 68px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.tools { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 26px; align-items: center; }
.search { flex: 1; min-width: 240px; border: 1px solid var(--line); border-radius: 3px; padding: 15px 18px; background: #fff; font: 14px inherit; outline: none; box-shadow: inset 0 0 0 1px #fff; }
.filter { border: 1px solid var(--line); background: #fff; padding: 12px 16px; border-radius: 3px; cursor: pointer; font-size: 12px; transition: .2s; }
.filter:hover { border-color: var(--rose); color: var(--rose); }
.filter.active { background: var(--dark); color: white; }
.sort { margin-left: auto; border: 1px solid var(--line); border-radius: 3px; padding: 12px 15px; background: #fff; font-size: 12px; transition: .2s; }

/* Grid de Produtos */
.grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
.product { background: #fff; border: 1px solid var(--line); border-radius: 4px; overflow: hidden; transition: .25s; box-shadow: 0 8px 24px #32251a0a; }
.product:hover { transform: translateY(-5px); box-shadow: 0 16px 30px #32251a18; }
.photo { height: 275px; position: relative; display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg, #f1e4dd, #fbf7f2); }
.product:nth-child(3n) .photo { background: linear-gradient(145deg, #e8e3db, #faf8f4); }
.product:nth-child(4n) .photo { background: linear-gradient(145deg, #e3d5c3, #f8efe5); }
.miniBottle { width: 76px; height: 135px; border-radius: 17px 17px 12px 12px; background: linear-gradient(90deg, #a37c6d, #ead0c5, #936b60); box-shadow: 18px 18px 35px #4b342728; position: relative; }
.miniBottle:before { content: ''; position: absolute; left: 23px; top: -20px; width: 30px; height: 22px; background: #b9996e; border-radius: 5px 5px 2px 2px; }
.miniBottle:after { content: 'CP'; position: absolute; left: 0; right: 0; top: 57px; text-align: center; color: #fff; font: 600 14px 'Playfair Display'; }
.badge { position: absolute; left: 12px; top: 12px; background: #fff; padding: 6px 9px; border-radius: 3px; font-size: 10px; font-weight: 700; letter-spacing: .3px; }
.heart { position: absolute; right: 10px; top: 10px; border: 0; background: #fff; border-radius: 50%; width: 34px; height: 34px; cursor: pointer; transition: .2s; }
.heart:hover { color: var(--rose); transform: scale(1.08); }
.info { padding: 19px; }
.brandline { font-size: 10px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--muted); }
.pname { font: 600 21px 'Playfair Display'; margin: 5px 0; }
.size { font-size: 11px; color: var(--muted); }
.price { font-size: 22px; font-weight: 700; margin: 11px 0; }
.old { font-size: 12px; text-decoration: line-through; color: #9b9188; margin-right: 6px; }
.add { width: 100%; border: 0; background: var(--dark); color: white; border-radius: 3px; padding: 13px; cursor: pointer; font-weight: 700; transition: .2s; }
.add:hover { background: var(--rose); }

/* Instagram Section */
.instagram { padding: 78px 0; }
.instaGrid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }
.insta { aspect-ratio: 1; border-radius: 4px; background: linear-gradient(135deg, #d6b9ad, #f1e5dd); display: flex; align-items: center; justify-content: center; font-size: 35px; filter: saturate(.75); transition: .25s; }
.insta:hover { filter: saturate(1); transform: scale(1.02); }

/* Footer */
.footer { background: #302923; color: #fff; padding: 62px 0; }
.footerGrid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 40px; }
.footer h3 { font: 600 20px 'Playfair Display'; margin: 0 0 10px; }
.footer p, .footer a { color: #d6cec7; font-size: 13px; line-height: 1.8; }
.footer a { display: block; text-decoration: none; color: #ddd1c7; transition: .2s; }
.footer a:hover { color: #fff; }
.copy { border-top: 1px solid #ffffff20; margin-top: 30px; padding-top: 20px; font-size: 11px; color: #b9aaa0; }

/* Carrinho Drawer */
.drawer { position: fixed; right: -420px; top: 0; width: min(420px, 100%); height: 100%; background: #fff; z-index: 50; box-shadow: -20px 0 60px #0002; transition: .3s; padding: 28px; display: flex; flex-direction: column; }
.drawer.open { right: 0; }
.drawerHead { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--line); padding-bottom: 18px; }
.drawer h2 { font: 600 28px 'Playfair Display'; margin: 0; }
.cartItems { flex: 1; overflow: auto; padding: 15px 0; }
.cartrow { display: flex; justify-content: space-between; gap: 10px; padding: 15px 0; border-bottom: 1px solid var(--line); }
.qty { display: flex; align-items: center; gap: 8px; }
.qty button { border: 1px solid var(--line); background: white; border-radius: 50%; width: 27px; height: 27px; }
.total { border-top: 1px solid var(--line); padding-top: 18px; font-weight: 700; font-size: 18px; }
.checkout { margin-top: 12px; border: 0; border-radius: 3px; background: #738d72; color: white; padding: 15px; font-weight: 700; cursor: pointer; transition: .2s; }
.checkout:hover { background: #5e785d; }
.overlay { position: fixed; inset: 0; background: #0005; z-index: 40; display: none; }
.overlay.show { display: block; }
.count { display: none; position: absolute; background: #a77b70; color: white; border-radius: 50%; width: 18px; height: 18px; font-size: 10px; align-items: center; justify-content: center; margin: -8px 0 0 23px; }
.cartWrap { position: relative; }

/* Media Queries */
@media(min-width: 901px) {
    .nav { display: flex; }
    .heroGrid { grid-template-columns: 1.05fr .95fr; }
    .collections { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
}
@media(max-width: 900px) {
    .nav { display: none; }
    .heroGrid { grid-template-columns: 1fr; }
    .heroCopy { padding: 55px 42px; }
    .heroArt { min-height: 430px; }
    .collections { grid-template-columns: repeat(3, 1fr); }
    .collection { height: 180px; }
    .grid { grid-template-columns: repeat(3, 1fr); }
    .instaGrid { grid-template-columns: repeat(3, 1fr); }
    .footerGrid { grid-template-columns: 1fr 1fr; }
}
@media(max-width: 640px) {
    .wrap { padding: 0 15px; }
    .top { font-size: 9px; letter-spacing: .5px; }
    .head { height: 70px; }
    .brand { font-size: 23px; }
    .hero { padding-top: 18px; }
    .heroGrid { min-height: 0; }
    .heroCopy { padding: 40px 25px; }
    .hero h1 { font-size: 46px; }
    .heroArt { min-height: 330px; }
    .buttons { flex-direction: column; }
    .buttons .btn { text-align: center; }
    .benefits { grid-template-columns: 1fr; margin-bottom: 54px; }
    .collections { grid-template-columns: 1fr 1fr; }
    .collection { height: 160px; padding: 17px; }
    .collection strong { font-size: 18px; }
    .catalog { margin-top: 54px; padding: 50px 0; }
    .tools { gap: 8px; }
    .filter { padding: 11px 12px; }
    .sort { margin-left: 0; width: 100%; }
    .grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .photo { height: 190px; }
    .info { padding: 13px; }
    .pname { font-size: 17px; }
    .price { font-size: 18px; }
    .add { font-size: 12px; padding: 11px 6px; }
    .sectionHead { display: block; }
    .instaGrid { gap: 7px; }
    .footerGrid { grid-template-columns: 1fr; gap: 25px; }
}